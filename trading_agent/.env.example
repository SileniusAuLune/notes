# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Alpaca (US Stocks) ────────────────────────────────────────────────────────
# 1. Sign up free at https://alpaca.markets
# 2. Go to Paper Trading → Overview → API Keys → Generate New Key
# 3. Paste the key and secret below
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true          # true = paper trade, false = real money (be careful!)

# ── OANDA (Forex) ─────────────────────────────────────────────────────────────
# 1. Sign up free at https://www.oanda.com/register/#/sign-up/demo
# 2. Log in → My Account → Manage API Access → Generate Personal Access Token
# 3. Your account ID is shown on the fxTrade Practice dashboard
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_PRACTICE=true        # true = practice account, false = live (be careful!)

# ── What to trade (comma-separated, no spaces) ────────────────────────────────
STOCK_SYMBOLS=AAPL,MSFT,NVDA,SPY
FOREX_PAIRS=EUR_USD,GBP_USD

# ── Risk management ───────────────────────────────────────────────────────────
MAX_POSITION_SIZE_PCT=0.02  # 2% of portfolio per trade (keep this low to start)
MIN_CONFIDENCE=0.65         # Claude must be ≥65% confident to execute a trade

# ── Scanning schedule ─────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15    # How often the agent wakes up to scan
LOOKBACK_DAYS=60            # Days of historical data for indicator calculation
